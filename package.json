{
  "name": "ascentio-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo/metro-runtime": "^56.0.16",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@stripe/stripe-react-native": "^0.64.0",
    "@tanstack/query-async-storage-persister": "5.101.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-persist-client": "5.101.0",
    "axios": "^1.17.0",
    "better-auth": "^1.6.18",
    "expo": "~56.0.0",
    "expo-apple-authentication": "^56.0.4",
    "expo-constants": "^56.0.19",
    "expo-dev-client": "^56.0.21",
    "expo-font": "^56.0.7",
    "expo-linking": "^56.0.14",
    "expo-notifications": "^56.0.18",
    "expo-router": "^56.2.12",
    "expo-secure-store": "^56.0.4",
    "expo-sharing": "~56.0.25",
    "expo-splash-screen": "^56.0.11",
    "expo-status-bar": "^56.0.4",
    "expo-web-browser": "^56.0.5",
    "nativewind": "^4.1.23",
    "posthog-react-native": "^4.53.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "0.2.5",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-svg": "^15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "^0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.17",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "^56.0.16",
    "jest": "^29.7.0",
    "tailwindcss": "3.3.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "cd android && ./gradlew assembleRelease",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.[tj]sx?$": [
        "babel-jest",
        {
          "presets": [
            [
              "@babel/preset-env",
              {
                "targets": {
                  "node": "current"
                }
              }
            ],
            "@babel/preset-typescript"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@tanstack)/)"
    ]
  },
  "private": true
}
