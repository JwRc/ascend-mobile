{
  "expo": {
    "name": "Ascentio",
    "slug": "ascentio-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "ascentio",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.ascentiomobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "O Ascentio usa a câmera para escanear dados do cartão ao adicionar uma forma de pagamento.",
        "NSMicrophoneUsageDescription": "O Ascentio pode usar o microfone durante o fluxo de pagamento e verificação.",
        "NSPhotoLibraryUsageDescription": "O Ascentio acessa suas fotos para anexar comprovantes e documentos quando necessário.",
        "NSPhotoLibraryAddUsageDescription": "O Ascentio salva imagens na sua galeria, como o card de comemoração de PR."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#efeeec",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.ascentiomobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Ascentio to use Face ID."
        }
      ],
      "expo-splash-screen",
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.anonymous.ascentiomobile",
          "enableGooglePay": false
        }
      ],
      "expo-sharing",
      "expo-apple-authentication",
      "expo-notifications",
      "./plugins/withUserLeaveHintFix"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d1b4c973-825b-483f-8ea2-8d9a7849e3a6"
      }
    }
  }
}
